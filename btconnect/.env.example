# Configure these in the hosting service's private variables. No real secrets here.
PUBLIC_URL=https://deployment.example.invalid
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
TOKEN_ENCRYPTION_KEY=
EBAY_ALLOWED_SELLER=ballardtradingco
BTCO_DB_PATH=/data/btco.sqlite3
# Railway supplies PORT. For another host the default is 8000.


# Enable only after owner consent and exact pilot readiness review.
BTCO_PUBLICATION_ENABLED=false

# Optional hosted comic research: disabled until both are explicitly configured.
# Provision secrets securely; never commit a real key. This pilot is <= $5 lifetime,
# not daily/monthly. Preserve the database ledger and account for earlier test usage.
OPENAI_API_KEY=
BTCO_AI_BUDGET_USD=0



# Optional exact standalone Core OAuth callback; other non-ChatGPT callbacks remain denied.
BTCORE_CALLBACK_URL=https://deployment.example.invalid/api/ebay/callback
