# Dedicated Core Dev only. No BTConnect credentials or shared production data.
BTCORE_ORIGIN=https://deployment.example.invalid
DATABASE_URL=postgresql://migration_admin:replace-securely@core-dev-postgres:5432/btcore_dev
BTCORE_APP_DB_PASSWORD=replace-securely
BTCORE_APP_DATABASE_URL=postgresql://btcore_app:replace-securely@core-dev-postgres:5432/btcore_dev
# SHA-256 of a random 32-byte setup code. Never commit the code itself.
BTCORE_SETUP_TOKEN_HASH=
PORT=3000
# Explicit local development only:
# BTCORE_LOCAL=1
# BTCORE_SQLITE_PATH=/private/local/btcore.sqlite

# Optional development-only convenience. Anyone with the URL can read/write.
# Leave private for account-based access; open skips setup and sign-in.
BTCORE_ACCESS_MODE=private

# Dedicated S3-compatible photo bucket. All five fields required when enabled.
# Use host variable references; never commit credential values.
# BTCORE_S3_ENDPOINT=
# BTCORE_S3_BUCKET=
# BTCORE_S3_REGION=auto
# BTCORE_S3_ACCESS_KEY_ID=
# BTCORE_S3_SECRET_ACCESS_KEY=

# Optional server-only card identification and listing preparation.
OPENAI_API_KEY=


# Direct eBay publishing. Tokens remain encrypted in a device-bound HttpOnly cookie.
# Configure this exact Core callback on BTConnect as BTCORE_CALLBACK_URL.
BTCONNECT_ORIGIN=https://deployment.example.invalid
# Random 32 bytes encoded as 64 hex characters; server-only, never commit a value.
BTCORE_CONNECTOR_KEY=
