# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Shared domain modules copied for the browser during build.
/public/core.mjs
/public/ebay-import.mjs
/public/sync-pack.mjs
/public/ebay-refresh.mjs
/public/device-merge.mjs

*.tsbuildinfo

# Vision generated browser modules, dependencies and private runtime data.
/public/vision.mjs
/public/vision-economics.mjs
/public/vision-legacy-matcher.mjs
/public/psa-public.mjs
**/node_modules/
**/xcuserdata/
**/DerivedData/
**/psa-cache.json
/services/vision-node/*.csv
!/services/vision-node/.env.example

/public/intake-contract.mjs
/public/vision-intake.mjs

/public/ebay-api-refresh.mjs

/public/module-views.mjs
/public/listing-collector.mjs
/public/publication-receipt.mjs
/public/data/

!/.openai/hosting.json
